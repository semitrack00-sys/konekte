generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Locale {
  en
  ht
  fr
}
enum SubscriptionState {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELING
  CANCELED
  EXPIRED
}
enum PaymentState {
  PENDING
  SUCCEEDED
  FAILED
}
enum EsimState {
  CREATED
  READY
  INSTALLED
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
  ERROR
}
enum InstallationState {
  NOT_CREATED
  PROVISIONING
  READY_TO_INSTALL
  INSTALLING
  INSTALLED
  ACTIVATING
  ACTIVE
  FAILED
}
enum JobState {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}
enum ProviderOperationState {
  PENDING
  RUNNING
  SUCCEEDED
  RETRYABLE_FAILURE
  FAILED
  RECONCILIATION_REQUIRED
}
enum ProviderOperationType {
  PROVISION
  STATUS
  ACTIVATE
  TOP_UP
  USAGE
  SUSPEND
  RESUME
  TERMINATE
  RECONCILE
  RENEWAL_PACKAGE
}
enum ReconciliationKind {
  PAID_BUT_NOT_PROVISIONED
  LOCAL_ACTIVE_PROVIDER_INACTIVE
  PROVIDER_ACTIVE_LOCAL_PENDING
  RENEWAL_PAID_PACKAGE_NOT_ASSIGNED
  USAGE_SYNC_STALE
  UNKNOWN_PROVIDER_ESIM
}
enum ReconciliationStatus {
  OPEN
  RESOLVED
}
enum ProviderEnvironment {
  SANDBOX
  PRODUCTION
}
enum QualificationAnswer {
  UNKNOWN
  YES
  NO
  NOT_APPLICABLE
}
model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  locale       Locale         @default(en)
  createdAt    DateTime       @default(now())
  sessions     Session[]
  devices      Device[]
  subscriptions Subscription[]
}
model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  familyId    String   @db.Uuid
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([userId])
  @@index([familyId])
}
model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  supportsEsim Boolean
  unlocked     Boolean
  compatible   Boolean
  verification String   @default("SELF_REPORTED")
  createdAt    DateTime @default(now())
  subscriptions Subscription[]
  @@index([userId])
}
model Plan {
  id           String @id
  name         String
  dataGb       Int
  durationDays Int
  priceCents   Int
  currency     String @default("usd")
  pricingLabel String @default("PLACEHOLDER_PRICING")
  enabled      Boolean @default(true)
  subscriptions Subscription[]
  providerMappings PlanProviderMapping[]
}
model Subscription {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  user       User   @relation(fields: [userId], references: [id])
  deviceId   String @db.Uuid
  device     Device @relation(fields: [deviceId], references: [id])
  planId     String
  plan       Plan @relation(fields: [planId], references: [id])
  state      SubscriptionState @default(PENDING)
  createdAt  DateTime @default(now())
  expiresAt  DateTime?
  payment    Payment?
  esim       Esim?
  periodStart DateTime?
  periodEnd DateTime?
  renewals RenewalPayment[]
  providerMappingId String? @db.Uuid
  providerMapping PlanProviderMapping? @relation(fields: [providerMappingId], references: [id], onDelete: Restrict)
  providerIdSnapshot String?
  providerProductIdSnapshot String?
  providerMappingVersion Int?
  @@index([userId])
}
model Payment {
  id               String @id @default(uuid()) @db.Uuid
  subscriptionId   String @unique @db.Uuid
  subscription     Subscription @relation(fields: [subscriptionId], references: [id])
  checkoutKey      String @unique
  checkoutReference String? @unique
  checkoutUrl      String?
  amountCents      Int
  currency         String
  mode             String
  state            PaymentState @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  events           WebhookEvent[]
}
model WebhookEvent {
  id          String @id
  type        String
  paymentId   String @db.Uuid
  payment     Payment @relation(fields: [paymentId], references: [id])
  processedAt DateTime @default(now())
}
model Esim {
  id                String @id @default(uuid()) @db.Uuid
  subscriptionId    String @unique @db.Uuid
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  provider          String
  providerReference String? @unique
  simulated         Boolean @default(true)
  state             EsimState @default(CREATED)
  installationState InstallationState @default(NOT_CREATED)
  activationCipher  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  job               ProvisioningJob?
  usage             Usage[]
}
model ProvisioningJob {
  id          String @id @default(uuid()) @db.Uuid
  esimId      String @unique @db.Uuid
  esim        Esim @relation(fields: [esimId], references: [id])
  state       JobState @default(PENDING)
  attempts    Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  lastError   String?
  createdAt   DateTime @default(now())
  @@index([state, availableAt])
}
model Usage {
  id         String @id @default(uuid()) @db.Uuid
  esimId     String @db.Uuid
  esim       Esim @relation(fields: [esimId], references: [id])
  usedBytes  BigInt
  totalBytes BigInt
  measuredAt DateTime
  simulated  Boolean
  @@index([esimId, measuredAt])
}
model Provider {
  id String @id
  displayName String
  enabled Boolean @default(false)
  simulated Boolean @default(true)
  healthStatus String @default("UNKNOWN")
  capabilities Json
  products ProviderProduct[]
  mappings PlanProviderMapping[]
  operations ProviderOperation[]
  webhookEvents ProviderWebhookEvent[]
  reconciliationIssues ReconciliationIssue[]
  configuration ProviderConfiguration?
  qualifications ProviderQualification[]
}
model ProviderProduct {
  id String @id @default(uuid()) @db.Uuid
  providerId String
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerProductId String
  countryCode String
  name String
  dataGb Int
  durationDays Int
  simulated Boolean @default(true)
  enabled Boolean @default(true)
  wholesalePriceCents Int?
  wholesaleCurrency String?
  networkMetadata Json?
  capabilityMetadata Json?
  mappings PlanProviderMapping[]
  @@unique([providerId, providerProductId, countryCode])
}
model PlanProviderMapping {
  id String @id @default(uuid()) @db.Uuid
  planId String
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  providerId String
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerProductId String @db.Uuid
  product ProviderProduct @relation(fields: [providerProductId], references: [id], onDelete: Cascade)
  active Boolean @default(true)
  version Int @default(1)
  effectiveAt DateTime @default(now())
  createdAt DateTime @default(now())
  subscriptions Subscription[]
  audits ProviderMappingAudit[]
  @@unique([planId, providerId, version])
  @@index([planId, providerId, active])
}
model ProviderConfiguration {
  id String @id @default(uuid()) @db.Uuid
  providerId String @unique
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  apiBaseUrl String?
  apiKeyReference String?
  webhookSecretReference String?
  accountCustomerId String?
  timeoutMs Int @default(10000)
  maxAttempts Int @default(3)
  retryBaseDelayMs Int @default(250)
  retryMaxDelayMs Int @default(5000)
  enabledCountries String[] @default([])
  environment ProviderEnvironment @default(SANDBOX)
  capabilityOverrides Json?
  enabled Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model ProviderQualification {
  id String @id @default(uuid()) @db.Uuid
  providerId String
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  countryCode String @default("HT")
  haitiSupported QualificationAnswer @default(UNKNOWN)
  networkNames String[] @default([])
  lte4g QualificationAnswer @default(UNKNOWN)
  fiveG QualificationAnswer @default(UNKNOWN)
  persistentEsim QualificationAnswer @default(UNKNOWN)
  topUpSameEsim QualificationAnswer @default(UNKNOWN)
  packageReplacement QualificationAnswer @default(UNKNOWN)
  usageApi QualificationAnswer @default(UNKNOWN)
  usageWebhook QualificationAnswer @default(UNKNOWN)
  hotspotPolicy String?
  throttlingFup String?
  packageExpirationBehavior String?
  activationMethod String?
  qrInstallation QualificationAnswer @default(UNKNOWN)
  manualInstallation QualificationAnswer @default(UNKNOWN)
  webhookAuthentication String?
  idempotencySupport QualificationAnswer @default(UNKNOWN)
  reconciliationSupport QualificationAnswer @default(UNKNOWN)
  failedProvisioningRefundBehavior String?
  sandboxAvailable QualificationAnswer @default(UNKNOWN)
  productionAvailable QualificationAnswer @default(UNKNOWN)
  commercialMinimums Json?
  wholesaleCurrency String?
  updatedAt DateTime @updatedAt
  @@unique([providerId, countryCode])
}
model ProviderMappingAudit {
  id String @id @default(uuid()) @db.Uuid
  mappingId String @db.Uuid
  mapping PlanProviderMapping @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  planId String
  providerId String
  priorProductRecordId String?
  newProductRecordId String
  version Int
  actor String
  changedAt DateTime @default(now())
  @@index([planId, providerId, changedAt])
}
model ProviderOperation {
  id String @id @default(uuid()) @db.Uuid
  operationType ProviderOperationType
  entityType String
  entityId String
  providerId String
  provider Provider @relation(fields: [providerId], references: [id])
  providerRequestId String?
  providerReferenceId String?
  idempotencyKey String @unique
  status ProviderOperationState @default(PENDING)
  attempts Int @default(0)
  safeErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([entityType, entityId])
}
model ProviderWebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  providerId String
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  eventId String
  eventType String
  providerReferenceId String?
  processedAt DateTime @default(now())
  @@unique([providerId, eventId])
}
model ReconciliationIssue {
  id String @id @default(uuid()) @db.Uuid
  fingerprint String @unique
  kind ReconciliationKind
  entityType String
  entityId String
  providerId String?
  provider Provider? @relation(fields: [providerId], references: [id])
  status ReconciliationStatus @default(OPEN)
  safeDetails String
  detectedAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([status, detectedAt])
}
model RenewalPayment {
  id String @id @default(uuid()) @db.Uuid
  subscriptionId String @db.Uuid
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  checkoutReference String @unique
  idempotencyKey String @unique
  amountCents Int
  currency String
  mode String
  state PaymentState @default(PENDING)
  periodStart DateTime
  periodEnd DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events RenewalWebhookEvent[]
}
model RenewalWebhookEvent {
  id String @id
  type String
  renewalPaymentId String @db.Uuid
  renewalPayment RenewalPayment @relation(fields: [renewalPaymentId], references: [id], onDelete: Cascade)
  processedAt DateTime @default(now())
}
