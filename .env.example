# Run pnpm dev:setup to generate local-only secrets. Never commit .env.
NODE_ENV=development
PORT=4000
POSTGRES_USER=konekte
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://konekte:REPLACE@localhost:55432/konekte
TEST_DATABASE_URL=postgresql://konekte:REPLACE@localhost:55433/konekte_test
REDIS_URL=redis://localhost:56379
ACCESS_TOKEN_SECRET=
ACTIVATION_ENCRYPTION_KEY=
ESIM_PROVIDER=mock
BILLING_MODE=mock
# Only sk_test_ keys accepted. Leave blank for default mock billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_RETURN_URL=http://localhost:5173/checkout-return
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
